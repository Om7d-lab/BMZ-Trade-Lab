# Copy to .env. Values here run Docker Compose services locally.
DATABASE_URL=postgresql://bmz:bmz_local_password@localhost:5432/bmz_trade_lab?schema=public
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bmz-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
CONNECTOR_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
